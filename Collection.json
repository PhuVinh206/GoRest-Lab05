{
  "info": {
    "name": "2474802010441_PhamPhuVinh_GoRest_Fixed",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('userId');",
                  "pm.environment.unset('createdEmail');",
                  "const original = pm.iterationData.get('email') || 'vinhlab@example.com';",
                  "const local = original.split('@')[0].replace(/[^a-zA-Z0-9._-]/g, '');",
                  "const suffix = Date.now() + '_' + pm.info.iteration + '_' + Math.floor(Math.random() * 1000000);",
                  "pm.variables.set('uniqueEmail', local + '_' + suffix + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('POST - Status 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.test('POST - Co User ID', function () { pm.expect(data.id).to.exist; });",
                  "  pm.environment.set('userId', String(data.id));",
                  "  pm.environment.set('createdEmail', data.email);",
                  "  console.log('Created userId:', data.id, 'email:', data.email);",
                  "} else {",
                  "  console.log('POST failed:', pm.response.code, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GET - Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  " const data = pm.response.json();",
                  " pm.test('Kiem tra User ID', function () { pm.expect(String(data.id)).to.eql(pm.environment.get('userId')); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
