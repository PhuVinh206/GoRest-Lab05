        {
          "name": "POST User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"POST - Status 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    const data = pm.response.json();\r",
                  "\r",
                  "    pm.environment.set(\"userId\", data.id);\r",
                  "    pm.environment.set(\"createdEmail\", data.email);\r",
                  "\r",
                  "    console.log(\"Saved userId:\", data.id);\r",
                  "    console.log(\"Saved createdEmail:\", data.email);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"{{name}}\",\r\n    \"gender\": \"{{gender}}\",\r\n    \"email\": \"{{email}}\",\r\n    \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
