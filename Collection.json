        {
          "name": "POST Duplicate Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.environment.get('createdEmail');",
                  "if (!email) { throw new Error('Chua co createdEmail tu POST User'); }",
                  "pm.variables.set('duplicateRequestEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('POST Duplicate - Status 422', function () { pm.response.to.have.status(422); });",
                  "if (pm.response.code === 422) {",
                  " const data = pm.response.json();",
                  " pm.test('Duplicate - Email already taken', function () {",
                  "  pm.expect(JSON.stringify(data).toLowerCase()).to.include('taken');",
                  " });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "bearer",
